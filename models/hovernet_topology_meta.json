{
  "model": "hovernet_topology_seg.onnx",
  "architecture": "HoVerNet (ResNet50 backbone, onnx2torch GraphModule)",
  "task": "Binary topology segmentation (material/void)",
  "base_init": "HoVerNet fold12 pretrained weights (not included in this repository)",
  "training_phase1": {
    "dataset": "MIT TopoDiff (cons_pf_array, 64x64x3)",
    "samples": 30000,
    "epochs": 15,
    "loss": "CE + Dice + Focal + Boundary",
    "best_epoch": 15,
    "best_dice": 0.8492,
    "best_iou": 0.7387,
    "accuracy": 0.9915,
    "precision": 0.8633,
    "recall": 0.8376
  },
  "input": {
    "shape": [1, 3, 256, 256],
    "format": "NCHW float32, raw uint8 [0,255] normalized to float",
    "description": "3-channel physical fields: ch0=strain energy, ch1=volume fraction, ch2=load"
  },
  "outputs": {
    "np": {"shape": [1, 2, 164, 164], "description": "Nuclear/foreground probability (binary topology)"},
    "hv": {"shape": [1, 2, 164, 164], "description": "Hover (unused for topology)"},
    "tp": {"shape": [1, 6, 164, 164], "description": "Type classification (unused)"}
  },
  "onnx": {
    "opset": 18,
    "size_mb": 145,
    "inference_time_ms": 3300
  },
  "limitations": "Trained only on MIT TopoDiff. Not validated on Pereira/Cantilever distributions."
}
